# Copy to `.env` (never commit `.env`) and fill in — OR export these vars.
# An installing agent MUST ask the user for MOODLE_URL + token; never invent them.
#   set -a; source .env; set +a
#
# Auth model: token-file only. There is NO username/password login in this
# project. Get the token from Moodle: profile → Security keys → create a
# webservice token, then paste it into the token FILE (not here).

# Moodle base URL, no trailing slash. REQUIRED — the binary has no default.
# Example: MOODLE_URL=https://your-school.edu/moodle
MOODLE_URL=

# Extraction root; state lives in $MOODLE_ROOT/.moodle/state.json
MOODLE_ROOT=$PWD/smx

# File holding the webservice token (mode 600, min 16 chars). Path only —
# the secret itself must never appear in env, logs, or shell history.
MOODLE_TOKEN_FILE=$MOODLE_ROOT/.moodle/token

# Optional: 1/true/yes blocks all network (offline mode)
# MOODLE_OFFLINE=

# Optional tuning (defaults in src/config.rs)
# MOODLE_CONCURRENCY=8
# MOODLE_API_TIMEOUT_SECS=30
# MOODLE_FILE_TIMEOUT_SECS=120
# MOODLE_MAX_RETRIES=3
# MOODLE_BACKOFF_BASE_MS=500
# MOODLE_MAX_RPS=8
# MOODLE_INDEX=1
# MOODLE_PDF_TEXT=1
# MOODLE_OCR=0
# MOODLE_ENRICH_LINKS=1
# MOODLE_STORE=tantivy
# MOODLE_LOCALE=ca
# MOODLE_THEME=light
# MOODLE_MOUSE=0

# Logging: info | debug | moodle_mcp=debug
RUST_LOG=info
